# Vorlage für .env — echte Werte gehören in .env (gitignored), nicht hierher.

# --- Embeddings: OpenAI direkt (beide Ingestion-Strategien) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large

# Muss zur bestehenden chunks-Tabelle passen: init_db() legt sie mit
# CREATE TABLE IF NOT EXISTS an und passt eine vorhandene Tabelle NICHT an einen
# geänderten Wert an — dann erst DROP TABLE chunks. Höchstens 2000: Die Suche
# läuft ohne HNSW-Index (ADR 011), die Grenze bleibt aber, damit er ohne neue
# Embeddings zurückkommen kann (ADR 003).
# EMBEDDING_DIMENSIONS=1536

# --- Generation: Anthropic ---
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-5

# --- Azure: erst ab der Document-Intelligence-Phase nötig ---
# Auskommentiert lassen, solange kein Azure-Konto existiert: ein leerer Wert wäre der
# String "" und würde an der AnyHttpUrl-Validierung scheitern, statt None zu ergeben.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=

# --- Datenbank: Zugangsdaten aus docker-compose.yml ---
POSTGRES_DSN=postgresql://anlagen_copilot:anlagen_copilot@localhost:5432/anlagen_copilot

# Temperatur des Rerankers (0.0 bis 1.0); die Generierung mit Claude Sonnet 5 sendet keine
RERANK_TEMPERATURE=0.0

# Ingestion-Strategie: naive (Default) | advanced
# INGEST_STRATEGY=naive

# Suche der API (/api/ask); die Defaults sind die gemessene Konfiguration.
# Unabhängig von INGEST_STRATEGY, eine Anfrage kann die Strategie selbst wählen.
# ASK_STRATEGY=advanced
# ASK_K=5
# ASK_CANDIDATES=20
# ASK_RERANKER=claude-haiku-4-5-20251001

# Log-Level: DEBUG | INFO (Default) | WARNING | ERROR
# DEBUG gibt jede Seite einzeln aus — für den ersten Ingest-Lauf nützlich,
# weil sich ein Abbruch damit auf die Seite genau nachvollziehen lässt.
# LOG_LEVEL=INFO
